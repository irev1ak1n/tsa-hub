# Browser-safe (VITE_ values are bundled into the app; protected by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Native (Capacitor) builds only: absolute origin of the deployed site, so /api calls leave the app.
VITE_API_BASE_URL=

# Server-only (Vercel project env vars, Production + Preview). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
RESEND_FROM_EMAIL=
# Extra origins allowed to call /api/submit-feedback (comma-separated); the deployment's own host is always allowed.
ALLOWED_ORIGINS=
